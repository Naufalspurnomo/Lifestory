{
  "name": "lifestory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx",
    "layout:test": "tsx scripts/verify-family-layout.ts",
    "optimize:images": "node scripts/convert-images-to-webp.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:status": "npx prisma migrate status",
    "db:audit": "node scripts/audit-database.mjs",
    "auth:smoke": "node scripts/smoke-auth-production.mjs",
    "auth:reset-smoke": "node scripts/smoke-password-reset-production.mjs",
    "media:smoke": "node scripts/smoke-media-production.mjs",
    "postinstall": "npx prisma generate",
    "family:resync": "tsx scripts/resync-family-identities.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "framer-motion": "^12.24.11",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "next": "^15.5.18",
    "next-auth": "^4.24.14",
    "postcss": "^8.5.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.48.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.18",
    "fast-check": "^3.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "$postcss",
    "picomatch@<=2.3.1": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4"
  }
}
