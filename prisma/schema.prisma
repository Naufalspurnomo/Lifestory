// Lifestory - production schema
// Every family is different: multi-tree per user, multi-user per tree (shared family trees).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Identity ----------

model User {
  id                          String    @id @default(cuid())
  name                        String
  email                       String    @unique
  phone                       String?
  passwordHash                String
  role                        String    @default("user") // "admin" or "user"
  subscriptionActive          Boolean   @default(false)
  status                      String    @default("pending_email") // "pending_email" | "active" | "inactive" | "suspended"
  emailVerifiedAt             DateTime?
  consentAcceptedAt           DateTime?
  consentIp                   String?
  consentUserAgent            String?
  consentPolicyVersion        String?
  sessionVersion              Int       @default(1)
  firstTreeWelcomeTreeId      String?
  firstTreeWelcomeDismissedAt DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  trees                        Tree[]                   @relation("TreeOwner")
  memberships                  TreeMember[]
  createdTreeInvites           TreeInvite[]             @relation("TreeInviteCreator")
  acceptedTreeInvites          TreeInvite[]             @relation("TreeInviteAcceptor")
  familyDiscoveryProfile       FamilyDiscoveryProfile?
  createdFamilyIdentities      FamilyIdentity[]         @relation("FamilyIdentityCreator")
  familyAccessRequests         FamilyAccessRequest[]    @relation("FamilyAccessRequester")
  reviewedFamilyAccessRequests FamilyAccessRequest[]    @relation("FamilyAccessReviewer")
  familyEvidence               FamilyEvidence[]
  proposedFamilyMerges         FamilyMergeProposal[]    @relation("FamilyMergeProposer")
  reviewedFamilyMerges         FamilyMergeProposal[]    @relation("FamilyMergeReviewer")
  resetTokens                  PasswordResetToken[]
  emailVerificationTokens      EmailVerificationToken[]
  authoredStories              Story[]                  @relation("StoryAuthor")
  uploadedMedia                MediaAsset[]             @relation("MediaUploader")
  createdContributionRequests  ContributionRequest[]    @relation("ContributionRequester")
  submittedProposals           ContributionProposal[]   @relation("ProposalSubmitter")
  reviewedProposals            ContributionProposal[]   @relation("ProposalReviewer")
  treeAuditEvents              TreeAuditEvent[]         @relation("TreeAuditActor")
  studioLeads                  StudioLead[]
  uploadedStudioDeliverables   StudioDeliverable[]      @relation("DeliverableUploader")
  whatsAppOutbox               WhatsAppOutbox[]
}

model WhatsAppOutbox {
  id            String   @id @default(cuid())
  userId        String
  kind          String
  recipient     String
  status        String   @default("pending")
  attemptCount  Int      @default(0)
  nextAttemptAt DateTime @default(now())
  processingAt  DateTime?
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([status, nextAttemptAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Durable audit trail for consent captured on the public contact / consultation
// form. Contact inquiries are not stored as accounts, so this table is the only
// persistent proof that a submitter agreed to data processing, independent of
// whether the notification email was successfully delivered.
model ContactConsentLog {
  id                   String   @id @default(cuid())
  email                String
  name                 String
  consentAcceptedAt    DateTime
  consentIp            String?
  consentUserAgent     String?
  consentPolicyVersion String
  createdAt            DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// Shared across Vercel instances so auth throttling survives cold starts and
// cannot be bypassed by landing on a different serverless invocation.
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ---------- Family Tree (tenant) ----------

model Tree {
  id               String    @id @default(cuid())
  name             String
  ownerId          String
  familyIdentityId String?
  version          Int       @default(1)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner                   User                   @relation("TreeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  familyIdentity          FamilyIdentity?        @relation("TreeFamilyIdentity", fields: [familyIdentityId], references: [id], onDelete: SetNull)
  canonicalFamilyIdentity FamilyIdentity?        @relation("CanonicalFamilyTree")
  nodes                   Node[]
  edges                   Edge[]
  memberships             TreeMember[]
  invites                 TreeInvite[]
  snapshots               TreeSnapshot[]
  syncReceipts            TreeSyncReceipt[]
  familyAccessRequests    FamilyAccessRequest[]
  familyMergeSources      FamilyMergeProposal[]  @relation("FamilyMergeSourceTree")
  familyMergeTargets      FamilyMergeProposal[]  @relation("FamilyMergeTargetTree")
  entitlement             TreeEntitlement?
  stories                 Story[]
  mediaAssets             MediaAsset[]
  contributionRequests    ContributionRequest[]
  contributionProposals   ContributionProposal[]
  auditEvents             TreeAuditEvent[]
  studioLeads             StudioLead[]
  studioDeliverables      StudioDeliverable[]

  @@index([ownerId])
  @@index([familyIdentityId])
  @@index([deletedAt])
}

model FamilyDiscoveryProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  personName              String
  birthYear               Int?
  fatherName              String?
  motherName              String?
  paternalGrandfatherName String?
  paternalGrandmotherName String?
  maternalGrandfatherName String?
  maternalGrandmotherName String?
  hometown                String?
  siblingNames            Json      @default("[]")
  profileHash             String
  consentAcceptedAt       DateTime
  retentionUntil          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([profileHash])
  @@index([retentionUntil])
}

// A privacy-preserving real-family identity layer. One real family can own one
// canonical tree and later reconcile duplicate trees through reviewed merges.
model FamilyIdentity {
  id              String   @id @default(cuid())
  displayName     String
  canonicalTreeId String?  @unique
  createdById     String
  status          String   @default("active") // "active" | "archived"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  canonicalTree  Tree?                 @relation("CanonicalFamilyTree", fields: [canonicalTreeId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("FamilyIdentityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  trees          Tree[]                @relation("TreeFamilyIdentity")
  matchKeys      FamilyMatchKey[]
  accessRequests FamilyAccessRequest[]
  evidence       FamilyEvidence[]
  mergeProposals FamilyMergeProposal[]

  @@index([createdById])
  @@index([status])
}

// Match keys are HMAC hashes only. Raw KK/NIK/names are never stored here.
model FamilyMatchKey {
  id               String   @id @default(cuid())
  familyIdentityId String
  keyType          String
  keyHash          String
  weight           Int      @default(1)
  createdAt        DateTime @default(now())

  familyIdentity FamilyIdentity @relation(fields: [familyIdentityId], references: [id], onDelete: Cascade)

  @@unique([familyIdentityId, keyType, keyHash])
  @@index([keyType, keyHash])
  @@index([familyIdentityId])
}

model FamilyAccessRequest {
  id               String    @id @default(cuid())
  familyIdentityId String
  treeId           String
  requesterId      String
  status           String    @default("pending") // "pending" | "approved" | "rejected"
  requestedRole    String    @default("editor") // "editor" | "viewer"
  confidence       Int
  matchReasons     Json      @default("[]")
  requesterSummary Json      @default("{}")
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  familyIdentity FamilyIdentity   @relation(fields: [familyIdentityId], references: [id], onDelete: Cascade)
  tree           Tree             @relation(fields: [treeId], references: [id], onDelete: Cascade)
  requester      User             @relation("FamilyAccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewedBy     User?            @relation("FamilyAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidence       FamilyEvidence[]

  @@unique([treeId, requesterId, status])
  @@index([familyIdentityId, status])
  @@index([treeId, status])
  @@index([requesterId, status])
}

model FamilyEvidence {
  id                String    @id @default(cuid())
  familyIdentityId  String?
  accessRequestId   String?
  userId            String
  kind              String
  documentHash      String?
  storageBucket     String?
  storageKey        String?
  retentionUntil    DateTime?
  consentAcceptedAt DateTime
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  familyIdentity FamilyIdentity?      @relation(fields: [familyIdentityId], references: [id], onDelete: SetNull)
  accessRequest  FamilyAccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyIdentityId])
  @@index([accessRequestId])
  @@index([userId])
  @@index([documentHash])
}

model FamilyMergeProposal {
  id               String    @id @default(cuid())
  familyIdentityId String?
  sourceTreeId     String
  targetTreeId     String
  proposedById     String
  status           String    @default("draft") // "draft" | "pending" | "approved" | "rejected" | "applied"
  preview          Json      @default("{}")
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  familyIdentity FamilyIdentity? @relation(fields: [familyIdentityId], references: [id], onDelete: SetNull)
  sourceTree     Tree            @relation("FamilyMergeSourceTree", fields: [sourceTreeId], references: [id], onDelete: Cascade)
  targetTree     Tree            @relation("FamilyMergeTargetTree", fields: [targetTreeId], references: [id], onDelete: Cascade)
  proposedBy     User            @relation("FamilyMergeProposer", fields: [proposedById], references: [id], onDelete: Cascade)
  reviewedBy     User?           @relation("FamilyMergeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([familyIdentityId])
  @@index([sourceTreeId])
  @@index([targetTreeId])
  @@index([status])
}

model TreeSnapshot {
  id        String   @id @default(cuid())
  treeId    String
  version   Int
  nodeCount Int
  data      Json
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt])
}

// Idempotency record for WAL batches. A client can safely resend the same
// batch when the server committed but the HTTP response was interrupted.
model TreeSyncReceipt {
  id                 String   @id
  treeId             String
  clientVersion      Int
  version            Int
  acknowledgedSeqNos Json
  nodeIds            Json
  createdAt          DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([treeId, version])
  @@index([treeId, createdAt])
}

// Join table: each tree can have multiple collaborators beyond the owner.
model TreeMember {
  id        String   @id @default(cuid())
  treeId    String
  userId    String
  role      String   @default("viewer") // "owner" | "editor" | "viewer"
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([treeId, userId])
  @@index([userId])
}

// One-time membership invitation. Only its SHA-256 token hash is persisted so
// a database read cannot be turned into a usable invite URL.
model TreeInvite {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  treeId       String
  createdById  String
  acceptedById String?
  role         String    @default("editor") // "editor" | "viewer"
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  tree       Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("TreeInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("TreeInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([treeId])
  @@index([expiresAt])
}

// Product access is intentionally tree-scoped. User.subscriptionActive remains
// only as a compatibility field while legacy customers are migrated.
model TreeEntitlement {
  id                        String   @id @default(cuid())
  treeId                    String   @unique
  tier                      String   @default("FREE") // FREE | LEGACY_UNLIMITED | STUDIO
  maxPeople                 Int      @default(500)
  maxVerifiedMembers        Int      @default(50)
  storageQuotaBytes         BigInt   @default(262144000)
  contributionLinksPerMonth Int      @default(20)
  snapshotLimit             Int      @default(30)
  studioVideoAllowed        Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
}

// ---------- Family graph ----------

model Node {
  id               String   @id @default(cuid())
  treeId           String
  label            String
  sex              String? // "M" | "F" | "X"
  birthYear        Int?
  deathYear        Int?
  line             String   @default("default")
  imageUrl         String?
  imageStorageKey  String?
  imageMimeType    String?
  imageSizeBytes   Int?
  description      String   @default("")
  // JSON blobs for rich content that doesn't need relational queries yet.
  media            Json     @default("[]")
  works            Json     @default("[]")
  socialInstagram  String?
  socialTiktok     String?
  socialLinkedin   String?
  generationCached Int      @default(0)
  siblingOrder     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  // Relations (explicit) - computed by reading Edge rows, but we keep backrefs
  // for faster traversal in app code.
  outgoingEdges        Edge[]                @relation("EdgeFrom")
  incomingEdges        Edge[]                @relation("EdgeTo")
  storyPeople          StoryPerson[]
  mediaAssets          MediaAsset[]
  contributionRequests ContributionRequest[]

  @@index([treeId])
}

// Unified relationship table. Each row = one directed semantic link.
// This lets us cleanly model biological parenting, adoption, partnership,
// divorce history (with startYear/endYear), etc. without collapsing them
// into a single union.
model Edge {
  id        String   @id @default(cuid())
  treeId    String
  fromId    String
  toId      String
  kind      String // "biological-parent" | "adoptive-parent" | "partner" | "ex-partner"
  startYear Int?
  endYear   Int?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  from Node @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Node @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([treeId, fromId, toId, kind])
  @@index([treeId, kind])
  @@index([fromId])
  @@index([toId])
}

// ---------- Living family archive ----------

model Story {
  id              String    @id @default(cuid())
  treeId          String
  title           String
  body            String
  occurredAt      DateTime?
  approximateYear Int?
  location        String?
  status          String    @default("draft") // draft | review | published
  visibility      String    @default("tree") // tree | private | selected
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tree   Tree          @relation(fields: [treeId], references: [id], onDelete: Cascade)
  author User          @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  people StoryPerson[]
  assets StoryAsset[]

  @@index([treeId, status, createdAt])
  @@index([authorId])
}

model StoryPerson {
  id       String @id @default(cuid())
  storyId  String
  personId String
  role     String // subject | narrator | witness | mentioned

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person Node  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([storyId, personId, role])
  @@index([personId])
}

model MediaAsset {
  id            String    @id @default(cuid())
  treeId        String
  personId      String?
  kind          String    @default("image") // image | studio_video
  storageKey    String
  checksum      String
  mimeType      String
  sizeBytes     BigInt
  caption       String?
  capturedAt    DateTime?
  uploaderId    String?
  visibility    String    @default("tree") // tree | private | selected
  consentStatus String    @default("unknown") // granted | unknown | revoked
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tree     Tree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  person   Node?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  uploader User?        @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  stories  StoryAsset[]

  @@unique([treeId, storageKey])
  @@index([treeId, createdAt])
  @@index([personId])
}

model StoryAsset {
  id           String @id @default(cuid())
  storyId      String
  mediaAssetId String
  role         String @default("source") // source | illustration

  story      Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([storyId, mediaAssetId, role])
  @@index([mediaAssetId])
}

model ContributionRequest {
  id             String    @id @default(cuid())
  treeId         String
  targetPersonId String?
  createdById    String
  prompt         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  status         String    @default("open") // open | submitted | expired | revoked
  createdAt      DateTime  @default(now())

  tree         Tree                  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  targetPerson Node?                 @relation(fields: [targetPersonId], references: [id], onDelete: SetNull)
  createdBy    User                  @relation("ContributionRequester", fields: [createdById], references: [id], onDelete: Restrict)
  proposal     ContributionProposal?

  @@index([treeId, createdAt])
  @@index([createdById])
  @@index([expiresAt])
}

model ContributionProposal {
  id            String    @id @default(cuid())
  treeId        String
  requestId     String?   @unique
  submittedById String?
  kind          String // story | person_fact | relationship | media_tag
  payload       Json
  status        String    @default("pending") // pending | approved | rejected
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  tree        Tree                 @relation(fields: [treeId], references: [id], onDelete: Cascade)
  request     ContributionRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  submittedBy User?                @relation("ProposalSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?                @relation("ProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([treeId, status, createdAt])
  @@index([submittedById])
}

model TreeAuditEvent {
  id         String   @id @default(cuid())
  treeId     String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  tree  Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  actor User? @relation("TreeAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([treeId, createdAt])
  @@index([actorId])
}

model StudioLead {
  id              String   @id @default(cuid())
  userId          String
  treeId          String?
  packageInterest String
  milestone       String?
  consentAt       DateTime
  status          String   @default("new") // new | contacted | qualified | won | lost
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree Tree? @relation(fields: [treeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([treeId, status])
}

model StudioDeliverable {
  id           String   @id @default(cuid())
  treeId       String
  uploadedById String
  kind         String // book_pdf | film | illustration
  title        String
  storageKey   String
  checksum     String?
  mimeType     String
  sizeBytes    BigInt
  createdAt    DateTime @default(now())

  tree       Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("DeliverableUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([treeId, storageKey])
  @@index([treeId, createdAt])
}
