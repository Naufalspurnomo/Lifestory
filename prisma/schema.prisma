// Lifestory - production schema
// Every family is different: multi-tree per user, multi-user per tree (shared family trees).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Identity ----------

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String
  role               String   @default("user") // "admin" or "user"
  subscriptionActive Boolean  @default(false)
  status             String   @default("inactive") // "active" | "inactive" | "suspended"
  sessionVersion     Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trees       Tree[]               @relation("TreeOwner")
  memberships TreeMember[]
  createdTreeInvites TreeInvite[]  @relation("TreeInviteCreator")
  acceptedTreeInvites TreeInvite[] @relation("TreeInviteAcceptor")
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Shared across Vercel instances so auth throttling survives cold starts and
// cannot be bypassed by landing on a different serverless invocation.
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ---------- Family Tree (tenant) ----------

model Tree {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("TreeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  nodes       Node[]
  edges       Edge[]
  memberships TreeMember[]
  invites     TreeInvite[]
  snapshots   TreeSnapshot[]
  syncReceipts TreeSyncReceipt[]

  @@index([ownerId])
}

model TreeSnapshot {
  id        String   @id @default(cuid())
  treeId    String
  version   Int
  nodeCount Int
  data      Json
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt])
}

// Idempotency record for WAL batches. A client can safely resend the same
// batch when the server committed but the HTTP response was interrupted.
model TreeSyncReceipt {
  id                 String   @id
  treeId             String
  clientVersion      Int
  version            Int
  acknowledgedSeqNos Json
  nodeIds            Json
  createdAt          DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([treeId, version])
  @@index([treeId, createdAt])
}

// Join table: each tree can have multiple collaborators beyond the owner.
model TreeMember {
  id        String   @id @default(cuid())
  treeId    String
  userId    String
  role      String   @default("viewer") // "owner" | "editor" | "viewer"
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([treeId, userId])
  @@index([userId])
}

// One-time membership invitation. Only its SHA-256 token hash is persisted so
// a database read cannot be turned into a usable invite URL.
model TreeInvite {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  treeId       String
  createdById  String
  acceptedById String?
  role         String    @default("editor") // "editor" | "viewer"
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  tree       Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("TreeInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("TreeInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([treeId])
  @@index([expiresAt])
}

// ---------- Family graph ----------

model Node {
  id                String   @id @default(cuid())
  treeId            String
  label             String
  sex               String? // "M" | "F" | "X"
  birthYear         Int?
  deathYear         Int?
  line              String   @default("default")
  imageUrl          String?
  description       String   @default("")
  // JSON blobs for rich content that doesn't need relational queries yet.
  media             Json     @default("[]")
  works             Json     @default("[]")
  socialInstagram   String?
  socialTiktok      String?
  socialLinkedin    String?
  generationCached  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  // Relations (explicit) - computed by reading Edge rows, but we keep backrefs
  // for faster traversal in app code.
  outgoingEdges Edge[] @relation("EdgeFrom")
  incomingEdges Edge[] @relation("EdgeTo")

  @@index([treeId])
}

// Unified relationship table. Each row = one directed semantic link.
// This lets us cleanly model biological parenting, adoption, partnership,
// divorce history (with startYear/endYear), etc. without collapsing them
// into a single union.
model Edge {
  id        String   @id @default(cuid())
  treeId    String
  fromId    String
  toId      String
  kind      String // "biological-parent" | "adoptive-parent" | "partner" | "ex-partner"
  startYear Int?
  endYear   Int?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  from Node @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Node @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([treeId, fromId, toId, kind])
  @@index([treeId, kind])
  @@index([fromId])
  @@index([toId])
}
