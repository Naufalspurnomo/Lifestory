# =============================================================================
# Lifestory — environment variables
# Copy this to `.env` for local dev or set them on your hosting provider for
# production. Never commit a real `.env` file.
# =============================================================================

# ---------- Database (Postgres) ----------
# DATABASE_URL is used by the running app (pooled connection, recommended for
# serverless and Edge runtimes).
# DIRECT_URL is used by Prisma CLI operations such as migrations. Supabase
# direct DB URLs are IPv6-only by default, so use the Supavisor session pooler
# on port 5432 unless your deployment environment has working IPv6.
# Both variables are required when using Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

# ---------- Authentication (NextAuth) ----------
# Generate with: `openssl rand -base64 32` (or any random 32+ char string).
NEXTAUTH_SECRET="replace_me_with_random_string_32_chars_min"

# Public origin of the deployed app. Used by NextAuth for callback URLs.
# Examples:
#   http://localhost:3000           (local dev)
#   https://lifestory.co.id         (production)
NEXTAUTH_URL="http://localhost:3000"

# CSRF / origin protection — comma-separated list, no trailing slash.
ALLOWED_ORIGINS="http://localhost:3000,https://lifestory.co.id,https://www.lifestory.co.id"

# Hostnames the app should answer to. Comma-separated.
ALLOWED_HOSTS="localhost,lifestory.co.id,www.lifestory.co.id"

# Required in production for `/api/health?database=1`. Send it as:
#   Authorization: Bearer <token>
HEALTH_DATABASE_CHECK_TOKEN="replace_me_with_random_string_32_chars_min"

# ---------- Transactional email (password reset + contact form) ----------
# Resend is used through its HTTP API from server-side routes. Create an API
# key in Resend and use a verified sender/domain for PASSWORD_RESET_FROM_EMAIL.
RESEND_API_KEY="replace_me"
PASSWORD_RESET_FROM_EMAIL="Lifestory <no-reply@lifestory.co.id>"

# ---------- Object storage (required for production media uploads) ----------
# Use an S3-compatible bucket such as Cloudflare R2, AWS S3, or Supabase S3.
# The app issues short-lived presigned PUT URLs so photos upload directly from
# the browser to the bucket; Postgres stores only URLs and metadata.
S3_ENDPOINT="replace_me"
S3_REGION="auto"
S3_ACCESS_KEY="replace_me"
S3_SECRET_KEY="replace_me"
S3_BUCKET="replace_me"
S3_PUBLIC_BASE_URL="replace_me"
MEDIA_FILE_MAX_BYTES="5242880"
MEDIA_TREE_QUOTA_BYTES="5368709120"
MEDIA_UPLOAD_URL_TTL_SECONDS="600"
